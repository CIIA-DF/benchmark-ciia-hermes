# Somente desenvolvimento local. A senha deve ser gerada antes de usar Compose.
POSTGRES_USER=benchmark
POSTGRES_DB=benchmark
POSTGRES_PASSWORD=
# Alternativa sem Docker, utilizada automaticamente quando DATABASE_URL não existe.
DATABASE_URL=sqlite:///./data/demo.db
BACKEND_URL=http://127.0.0.1:8000
# Reservado para os adaptadores futuros; a demonstração não usa LLM.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
