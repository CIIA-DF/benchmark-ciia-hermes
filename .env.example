# Somente desenvolvimento local. A senha deve ser gerada antes de usar Compose.
POSTGRES_USER=benchmark
POSTGRES_DB=benchmark
POSTGRES_PASSWORD=
# Alternativa sem Docker, utilizada automaticamente quando DATABASE_URL não existe.
DATABASE_URL=sqlite:///./data/demo.db
BACKEND_URL=http://127.0.0.1:8000
# Proxy do portal: leitura total do corpo e espera de cabeçalhos, por fase.
BACKEND_PROXY_TIMEOUT_SECONDS=20
# Inatividade de leitura da resposta; não limita a duração total do SSE.
BACKEND_PROXY_IDLE_TIMEOUT_SECONDS=30
BACKEND_OPERATOR_TOKEN=
BACKEND_WORKER_TOKEN=
ENABLED_EXECUTORS=simulation
RUN_LEASE_SECONDS=60
RUN_TIMEOUT_SECONDS=300
# Tempo positivo em fila desde created_at; separado do tempo de execução iniciada.
RUN_QUEUE_TIMEOUT_SECONDS=300
# Runs queued por operador; positivo. Compartilhado por benchmark e chat.
RUN_MAX_QUEUED_PER_OPERATOR=20
CHAT_CONTEXT_MAX_CHARS=100000
# Chamadas lógicas de tool por execução; 0 = sem limite até a decisão da Metodologia.
RUN_MAX_TOOL_CALLS=0
# Inferência dos adaptadores Hermes e LangGraph; a demonstração e o simulador não usam LLM.
# Gateway único da ADR 003 (provedor de inferência, hoje em team/evaluation): os dois
# executores usam o mesmo endpoint, modelo, chave e parâmetros na mesma rodada.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Desenvolvimento: variante gratuita ou openai/gpt-4o-mini. Camada 1: openai/gpt-4o-mini.
# Registre o modelo da rodada no manifesto do experimento; não altere no meio da coleta.
LLM_MODEL=
# Chave privada, entregue fora do Git e de grupos de mensagem. O adaptador de team/hermes
# (agents/hermes/adapter.py, fora desta branch) também lê OPENROUTER_API_KEY como
# alternativa; prefira LLM_API_KEY para os dois executores.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
