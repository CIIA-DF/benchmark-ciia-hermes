# Somente desenvolvimento local. A senha deve ser gerada antes de usar Compose.
POSTGRES_USER=benchmark
POSTGRES_DB=benchmark
POSTGRES_PASSWORD=
# Alternativa sem Docker, utilizada automaticamente quando DATABASE_URL não existe.
DATABASE_URL=sqlite:///./data/demo.db
BACKEND_URL=http://127.0.0.1:8000
# Inferência externa via OpenRouter (ADR 003). A demonstração local não usa LLM.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Modelos sugeridos:
# Desenvolvimento: meta-llama/llama-3.3-70b-instruct:free ou openai/gpt-4o-mini
# Camada 1 (Benchmark Orquestradores): openai/gpt-4o-mini
# Camada 2 (Gold Standard): anthropic/claude-sonnet-4.6 (ou claude-sonnet-4.5)
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
