# Preencha com uma senha local. As mesmas opções configuram o Compose e o Python.
RAG_POSTGRES_PASSWORD=
RAG_POSTGRES_PORT=5433
# Opcional: reutilize uma instância autorizada com pgvector e um banco dedicado.
# RAG_DATABASE_URL=postgresql+psycopg://usuario:senha@127.0.0.1:5433/rag

RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=75
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# Revisão e dimensão têm padrões para BGE-M3 e para o MiniLM documentado.
# RAG_EMBEDDING_REVISION=
# RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_BATCH_SIZE=4

RAG_RETRIEVAL_MODE=hybrid
RAG_CANDIDATE_K=20
RAG_TOP_K=5
RAG_RRF_K=60
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANK_REVISION=
RAG_RERANK_CANDIDATE_K=20
RAG_RERANK_BATCH_SIZE=2
RAG_RERANK_MAX_TOKENS=768
